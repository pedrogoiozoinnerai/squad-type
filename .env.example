# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma7.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Local dev: SQLite (sem infra extra). Em produção, troque o provider do datasource
# para "postgresql" no prisma/schema.prisma e aponte para o Postgres gerenciado.
DATABASE_URL="file:./dev.db"

# Nome exibido no cabeçalho, título e mensagens do funil
NEXT_PUBLIC_BRAND_NAME="Squad.com"

# Facebook Pixel (opcional) — ID do pixel para tracking + correspondência avançada
NEXT_PUBLIC_FB_PIXEL_ID=""

# Cal.com — link do tipo de evento usado no agendamento final (ex: "seu-usuario/diagnostico-ia")
NEXT_PUBLIC_CAL_LINK=""

# Cal.com — secret do webhook (Settings > Developer > Webhooks). Confirma o
# agendamento no servidor mesmo se o navegador do lead fechar antes de disparar
# o evento client-side. Veja instruções no README.
CAL_WEBHOOK_SECRET=""

# HubSpot — Private App Access Token (Configurações > Integrações > Private Apps).
# Necessário para criar/atualizar contatos e deals a cada lead. Veja README.
HUBSPOT_ACCESS_TOKEN=""

# HubSpot — pipeline e estágio (IDs internos, não o nome exibido) onde os deals
# são criados. Sem configurar, usa o pipeline padrão da conta ("default") e o
# primeiro estágio do pipeline de vendas padrão ("appointmentscheduled").
HUBSPOT_PIPELINE_ID=""
HUBSPOT_STAGE_ID=""

# HubSpot — estágio para onde o deal deve mover quando o lead agenda a reunião
# (opcional; se vazio, o deal fica no estágio inicial e só ganha uma nota).
HUBSPOT_STAGE_SCHEDULED_ID=""

# Opcional — compartilha o cookie de atribuição (UTMs/click ids) entre subdomínios
# do squad.com (ex: ".squad.com"). Deixe vazio se o funil roda no próprio domínio.
NEXT_PUBLIC_ATTRIBUTION_COOKIE_DOMAIN=""
