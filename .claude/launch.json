{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "squad-funil-dev",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-lc",
        "npm run clean:icloud; exec npx next dev"
      ],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "crm",
      "runtimeExecutable": "/bin/zsh",
