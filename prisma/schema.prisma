// Prisma schema — Funil de diagnóstico (Squad.com)
// Postgres (Supabase) em dev e em produção — dois projetos Supabase distintos,
// mesma estrutura, para que o que roda local seja o que roda publicado.
// Em produção este banco é compartilhado com o CRM e com o Dashboard.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum StepKey {
  NAME
  PHONE
  EMAIL
  COMPANY
  SEGMENT
  ROLE
  REVENUE
  SCHEDULE
}

model Lead {
  id        String   @id @default(cuid())
  sessionId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status      LeadStatus @default(IN_PROGRESS)
  currentStep StepKey    @default(NAME)
  completedAt DateTime?

  // Passo 1 — nome
  fullName String?

  // Passo 2 — WhatsApp
  phoneCountryCode String? // ex: "+55"
  phoneNumber      String? // dígitos, sem formatação
  phoneE164        String? // ex: "+5511987654321"
  ddd              String? // ex: "11"
  city             String? // derivado do DDD, ex: "São Paulo"
  state            String? // derivado do DDD, ex: "SP"

  // Passo 3 — e-mail
  email String?

  // Passo 4 — empresa
  company String?

  // Passo 5 — segmento
  segment String?

  // Passo 6 — cargo
  role String?

  // Passo 7 — faturamento anual
  revenueRange String?

  // Passo 8 — agendamento.
  //
  // A reserva passou a ser feita no CRM (sessões coletivas do MeetSquad); as
  // três colunas `cal*` ficam por enquanto porque o cron do CRM as lê por SQL a
  // cada dez minutos. Para leads novos elas nascem nulas.
  crmMeetingId    String?
  crmConviteUrl   String?
  calBookingUid   String?
  scheduledAt     DateTime?
  meetingLocation String?

  /// Quando a reserva foi cancelada no Cal.com.
  ///
  /// Anular `scheduledAt` seria mais simples e apagaria a diferença entre
  /// "nunca agendou" e "agendou e desmarcou" — e é justamente essa diferença
  /// que faz o CRM criar uma tarefa de retomada para o vendedor certo.
  calCancelledAt DateTime?

  // Consentimento LGPD
  consentAcceptedAt DateTime?
  privacyVersion    String?

  // Atribuição / rastreamento
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  fbclid      String?
  gclid       String?
  fbp         String?
  fbc         String?
  referrer    String?
  landingUrl  String?
  userAgent   String?
  ipAddress   String?

  events LeadEvent[]

  @@index([status])
  @@index([createdAt])
  /// O CRM espelha este funil lendo por `updatedAt` com marca d'água — a cada
  /// dez minutos, "o que mudou desde a última vez". Sem este índice a consulta
  /// varre a tabela inteira toda vez, e a tabela cresce 1.000 linhas por dia.
  @@index([updatedAt])
}

// Trilha de auditoria: cada resposta enviada durante o funil,
// útil para funil de abandono/analytics sem depender só do snapshot do Lead.
model LeadEvent {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  step      StepKey
  payload   String // JSON serializado da resposta daquele passo
  createdAt DateTime @default(now())

  @@index([leadId])
}
